  "temperature@fevimu": {
    "use-fahrenheit": {
      "type": "switch",
      "default": false,
      "description": "Show temperature in Fahrenheit",
      "value": false
    },
    "only-integer-part": {
      "type": "switch",
      "default": false,
      "description": "Use integer values for temperature",
      "value": false
    },
    "show-unit": {
      "type": "switch",
      "default": true,
      "description": "Show unit",
      "tooltip": "Whether or not show the unit after the temperature value.",
      "value": true
    },
    "show-unit-letter": {
      "type": "switch",
      "default": false,
      "description": "Show unit letter",
      "tooltip": "Whether or not show the unit letter (C or F).",
      "dependency": "show-unit",
      "value": false
    },
    "show-label-prefix": {
      "type": "switch",
      "default": false,
      "description": "Show label prefix",
      "tooltip": "Whether or not to add a label before the temperature value.",
      "value": false
    },
    "label-prefix": {
      "type": "entry",
      "default": "🌡",
      "description": "Label prefix",
      "tooltip": "The label to be shown before the temperature value.",
      "dependency": "show-label-prefix",
      "value": "🌡"
    },
    "interval": {
      "type": "spinbutton",
      "default": 5000,
      "min": 2000,
      "max": 30000,
      "step": 100,
      "units": "ms",
      "description": "Update interval",
      "value": 5000
    },
    "change-color": {
      "type": "switch",
      "default": true,
      "description": "Change color when the temperature becomes High or Critical",
      "tooltip": "Selecting this option, this applet becomes\n orange when the High Temperature Threshold is reached,\n red when the Critical Temperature Threshold is reached.",
      "value": true
    },
    "only-colors": {
      "type": "switch",
      "default": false,
      "dependency": "change-color",
      "description": "Only use colors to alert me",
      "tooltip": "Select this option to not display text alerts in horizontal panels.\n(No text alert is ever displayed on vertical panels.)",
      "value": false
    },
    "keep_size": {
      "type": "switch",
      "default": false,
      "description": "Avoid size changes",
      "tooltip": "Checked: The size of this applet remains constant, once all your preferences have been defined.\nUnchecked: The size of this applet is optimized, but it may change.",
      "value": false
    }
  },
